# ── Secrets & env ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Go (hub) ──────────────────────────────────────────────────
hub/bin/
*.test
coverage.out
coverage.html

# UI static export — built by `make ui`, served by the UI nginx image
ui/out/

# ── Node / Next.js (ui) ───────────────────────────────────────
ui/node_modules/
ui/.next/
ui/out/
ui/next-env.d.ts
ui/*.tsbuildinfo
ui/coverage/

# Playwright artifacts
ui/test-results/
ui/playwright-report/
# Session saved by ui/e2e/global-setup.ts. A live admin cookie — never commit it.
ui/e2e/.auth/
ui/blob-report/

# ── Gateway / deploy ──────────────────────────────────────────
gateway/build/
deploy/helm/**/charts/
deploy/helm/**/*.tgz

# ── Sensor (first-party Go modules) ───────────────────────────
sensor/tdp-estimator/tdp-estimator

# ── Logs & temp ───────────────────────────────────────────────
*.log
logs/
# …but logs/ must not swallow the UI Logs feature source (route + components).
# (ui/out/logs stays ignored via ui/out/ above — it's build output.)
!ui/app/logs/
!ui/src/components/logs/
tmp/
*.tmp

# ── OS / editors ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
!.vscode/extensions.json

# ── Machine-local Claude Code permissions ─────────────────────
.claude/settings.json

# Visual brainstorm sessions (superpowers companion)
.superpowers/

# Claude Code worktrees (local working copies, never committed)
.claude/worktrees/
