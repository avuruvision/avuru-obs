server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # Relative Location headers: this pod sits behind ingresses/port-forwards
    # whose external host:port nginx cannot know.
    absolute_redirect off;

    # Next.js static export: extensionless routes resolve to "<route>.html"
    # (e.g. /traces -> traces.html), with SPA fallback to index.html for
    # client-side routes. Trailing slashes are canonicalized away: the export
    # also emits an ASSETS directory per route (settings/ next to
    # settings.html), so "/settings/" would otherwise hit directory handling
    # and 403.
    rewrite ^/(.+)/$ /$1 permanent;

    # Hashed build assets are immutable and must NEVER fall back to index.html:
    # a missing chunk has to 404 cleanly, not return HTML — otherwise the
    # browser rejects the stylesheet ("non-CSS MIME type") and renders the page
    # unstyled. A miss here means stale HTML or multi-replica image skew; fix by
    # deploying one consistent image version, not by loosening this.
    location /_next/static/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri.html /index.html;
    }

    # Single-origin API proxy → hub. ${HUB_UPSTREAM} is set per environment
    # (compose: hub:8080; k8s: <release>-hub:8080) and filled by the nginx
    # image's envsubst. A literal upstream (no nginx variable, so no `resolver`
    # directive) is resolved at startup via the container's /etc/resolv.conf —
    # Docker DNS in compose, CoreDNS in k8s — which works in both.
    location /api/ {
        proxy_pass http://${HUB_UPSTREAM};
        # Forward the client's full Host INCLUDING the port ($http_host, not
        # $host — the latter strips the port). The hub's CSRF guard rejects any
        # state-changing request whose Origin host:port differs from the request
        # Host. Reached on a non-default external port (compose ...:3001, a
        # kubectl port-forward, a NodePort) the browser's Origin carries that
        # port, so a port-stripped Host would 403 every login and mutation.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location = /healthz {
        proxy_pass http://${HUB_UPSTREAM};
    }

    # MCP → hub. An MCP client is configured with a server URL, so the protocol
    # owns its path and cannot sit under /api — without this it would fall into
    # `location /` above and an agent would get the static export's 404. Exact
    # match: /mcp is the whole endpoint, and nothing else hangs off it.
    # Unconditional here, unlike the Ingress rule: with the module off the hub
    # 404s, which is the honest answer, and nginx has no view of hub modules.
    # Host is forwarded for the same CSRF reason as /api/ above.
    location = /mcp {
        proxy_pass http://${HUB_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # OAuth discovery → hub. RFC 8414 and RFC 9728 FIX these paths at the
    # origin root, so like /mcp they cannot live under /api — and unlike /mcp
    # they are what a client fetches BEFORE it holds any credential, so getting
    # them wrong breaks the flow at its first step. Without this rule they fall
    # into `location /` and a client parsing JSON receives the static export's
    # HTML with a 200, which fails deeper and more confusingly than a 404.
    #
    # Scoped to the `oauth-` prefix, not to /.well-known/: an ACME HTTP-01
    # challenge lives at /.well-known/acme-challenge/ and is served by the
    # ingress controller or by this static root, never by the hub. `^~` stops
    # nginx evaluating regex locations for these, so nothing later can reclaim
    # them.
    #
    # Unconditional, for the reason /mcp is: with OAuth off the hub registers
    # no such route and answers 404, which is the honest reply and a better one
    # than a page of HTML.
    location ^~ /.well-known/oauth- {
        proxy_pass http://${HUB_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
