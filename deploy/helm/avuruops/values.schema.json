{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Avuru Obs chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" }
      }
    },
    "hub": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 1 }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 1 }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "tenant": { "type": "string" },
        "sentry": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedOrigins": { "type": "array", "items": { "type": "string" } },
            "projects": { "type": "object" }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modules": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "required": ["enabled"]
        },
        "infraMetrics": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "required": ["enabled"]
        },
        "profiling": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "required": ["enabled"]
        },
        "errorTracking": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "required": ["enabled"]
        },
        "serviceHealth": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "required": ["enabled"]
        }
      },
      "required": ["logs", "infraMetrics", "profiling", "errorTracking", "serviceHealth"]
    },
    "serviceGroups": {
      "type": "object",
      "properties": {
        "defaultTier": { "type": "string", "enum": ["T0", "T1", "T2"] },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "tier": { "type": "string", "enum": ["T0", "T1", "T2"] },
              "selector": {
                "type": "object",
                "properties": {
                  "namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "services": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                }
              }
            },
            "required": ["name", "tier"]
          }
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "defaults": { "type": "object" },
            "tiers": { "type": "object" },
            "services": { "type": "object" }
          }
        },
        "criticalEdges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 }
            },
            "required": ["from", "to"]
          }
        }
      }
    },
    "sensor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "priorityClass": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "value": { "type": "integer" }
          }
        },
        "collection": {
          "type": "object",
          "properties": {
            "excludeNamespaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "optOutLabel": { "type": "string" },
            "nodeOptOutLabel": { "type": "string" }
          }
        },
        "obi": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "privileged": { "type": "boolean" },
            "discovery": {
              "type": "object",
              "properties": {
                "namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "excludeNamespaces": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 }
              }
            },
            "network": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        },
        "profiler": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "samplesPerSecond": { "type": "integer", "minimum": 1 },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "agent": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 }
              }
            },
            "logs": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "kubeletstats": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string", "minLength": 2 }
              }
            }
          }
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "properties": {
        "external": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "address": { "type": "string" },
            "database": { "type": "string" },
            "username": { "type": "string" },
            "existingSecret": { "type": "string" }
          },
          "required": ["enabled"]
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "storageClassName": { "type": "string" },
            "size": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "properties": {
        "traces": { "type": "integer", "minimum": 0 },
        "logs": { "type": "integer", "minimum": 0 },
        "metrics": { "type": "integer", "minimum": 0 },
        "profiles": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      },
      "required": ["traces", "logs", "metrics", "profiles", "errors"]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "sentryHost": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
